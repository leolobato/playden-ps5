--- a/lib/vtls/mbedtls.c
+++ b/lib/vtls/mbedtls.c
@@ -88,9 +88,11 @@
 #endif
   int *ciphersuites;
   size_t send_blocked_len;
+  size_t send_blocked_queued_len; /* what mbedtls_ssl_write() put in it */
   BIT(initialized); /* mbedtls_ssl_context is initialized */
   BIT(sent_shutdown);
   BIT(send_blocked);
+  BIT(send_blocked_queued); /* the blocked bytes sit in mbedTLS' pending record */
